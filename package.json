{
  "name": "sunat-peru",
  "version": "0.1.0",
  "description": "Emisión de facturas y boletas electrónicas a SUNAT desde Node.js, en TypeScript",
  "keywords": [
    "sunat",
    "peru",
    "facturacion-electronica",
    "ubl",
    "cpe",
    "factura",
    "boleta"
  ],
  "author": "Brayan Huincho",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "secretos": "node .github/scripts/verificar-secretos.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.3",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
